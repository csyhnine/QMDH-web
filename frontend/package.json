{
  "name": "qmdh-web-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:baseline": "node scripts/typecheck-baseline.mjs",
    "test:studio": "node --test scripts/test-studio-data-loader.mjs",
    "test:checks": "node --test scripts/test-studio-data-loader.mjs scripts/test-typecheck-baseline.mjs scripts/test-feedback-security.mjs scripts/test-video-templates.mjs scripts/test-other-tools.mjs scripts/test-gif-batch.mjs scripts/test-studio-navigation.mjs scripts/test-cad-preparation.mjs scripts/test-management.mjs",
    "check": "npm run test:checks && npm run typecheck:baseline && npm run build",
    "preview": "vite preview",
    "lint": "biome check src/lib",
    "lint:integrations": "biome check src/lib src/features/studio/StudioAssistantPanel.tsx src/features/studio/useSharedTemplateBrowser.ts src/features/studio/studioTemplateBrowserUtils.ts src/features/studio/StudioSharedTemplateSearch.tsx",
    "lint:all": "biome check .",
    "format": "biome format --write src/lib"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^5.0.0",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
